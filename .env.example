# Copy this file to ".env" (same folder) and fill in your own values.
# Never commit the real .env file.

MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority

# Account that sends the "forgot password" code emails.
# Gmail: enable 2-Step Verification, then create an App Password.
SMTP_EMAIL=sender-account@gmail.com
SMTP_PASSWORD=abcd efgh ijkl mnop

# Optional (defaults shown). Port 465 = SSL, any other port = STARTTLS (e.g. 587).
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=465

# ---- AI Chatbot (Phase 1) ----
# Free key for Gemini: https://aistudio.google.com/app/apikey
AI_PROVIDER=gemini
AI_API_KEY=your-ai-api-key
#AI_MODEL=gemini-2.5-flash

# Other options (provider "openai" = any OpenAI-compatible API):
#AI_PROVIDER=openai
#AI_MODEL=gpt-4o-mini
#AI_BASE_URL=https://api.openai.com/v1
# Groq example: AI_BASE_URL=https://api.groq.com/openai/v1  AI_MODEL=llama-3.3-70b-versatile
