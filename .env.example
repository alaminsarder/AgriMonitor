# Copy this file to ".env" (same folder) and fill in your own values.
# Never commit the real .env file.

MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority

# Account that sends the "forgot password" code emails.
# Gmail: enable 2-Step Verification, then create an App Password.
SMTP_EMAIL=sender-account@gmail.com
SMTP_PASSWORD=abcd efgh ijkl mnop

# Optional (defaults shown). Port 465 = SSL, any other port = STARTTLS (e.g. 587).
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=465
